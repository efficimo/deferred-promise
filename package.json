{
  "name": "@efficimo/deferred-promise",
  "version": "0.0.0",
  "description": "Extend native Promises with external resolve/reject, status tracking, timeout, abort signal, progress reporting, lazy execution and deferred maps. Fully typed. Directly awaitable.",
  "author": "efficimo",
  "license": "MIT",
  "keywords": [
    "promise",
    "deferred",
    "async",
    "timeout",
    "abort",
    "progress",
    "lazy",
    "typescript",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efficimo/deferred-promise.git"
  },
  "bugs": {
    "url": "https://github.com/efficimo/deferred-promise/issues"
  },
  "homepage": "https://github.com/efficimo/deferred-promise#readme",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-out/test/*.test.js",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^25.9.7",
    "typescript": "^7.0.2"
  }
}
